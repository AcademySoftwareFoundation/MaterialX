vector2 mx_transform_uv(vector2 texcoord)
{
    return vector2(texcoord.x, 1.0 - texcoord.y);
}

vector2 mx_transform_uv(vector2 texcoord, string filename)
{
    if (regex_search(filename, "<UDIM>"))
    {
        // For UDIM filenames, flip the V coordinate within each tile,
        // preserving the integer portion that selects the UDIM tile
        // at lookup time.
        return vector2(texcoord.x, 2.0 * floor(texcoord.y) + 1.0 - texcoord.y);
    }
    return vector2(texcoord.x, 1.0 - texcoord.y);
}
