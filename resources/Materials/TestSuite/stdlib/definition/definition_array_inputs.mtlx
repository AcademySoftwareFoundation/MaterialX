<?xml version="1.0"?>
<materialx version="1.39">
  <!-- Custom node with floatarray and integerarray inputs. Exercises array uniforms (a public
       uniform block containing arrays) and array constants (reduced shader interface). -->
  <nodedef name="ND_array_lookup_float" node="array_lookup" nodegroup="shader">
    <input name="values" type="floatarray" value="0.1, 0.2, 0.3, 0.4" />
    <input name="indices" type="integerarray" value="3, 2, 1, 0" />
    <output name="out" type="float" value="0.0" />
  </nodedef>

  <implementation name="IM_array_lookup_float_genglsl" nodedef="ND_array_lookup_float" target="genglsl" sourcecode="{{values}}[{{indices}}[1]]" />
  <implementation name="IM_array_lookup_float_genmsl" nodedef="ND_array_lookup_float" target="genmsl" sourcecode="{{values}}[{{indices}}[1]]" />
  <implementation name="IM_array_lookup_float_genosl" nodedef="ND_array_lookup_float" target="genosl" sourcecode="{{values}}[{{indices}}[1]]" />
  <implementation name="IM_array_lookup_float_genmdl" nodedef="ND_array_lookup_float" target="genmdl" sourcecode="{{values}}[{{indices}}[1]]" />
  <implementation name="IM_array_lookup_float_genslang" nodedef="ND_array_lookup_float" target="genslang" sourcecode="{{values}}[{{indices}}[1]]" />
  <implementation name="IM_array_lookup_float_genwgsl" nodedef="ND_array_lookup_float" target="genwgsl" sourcecode="{{values}}[{{indices}}[1]]" />

  <array_lookup name="lookup" type="float">
    <input name="values" type="floatarray" value="0.25, 0.5, 0.75, 1.0" />
    <input name="indices" type="integerarray" value="0, 2, 1, 3" />
  </array_lookup>
  <surface_unlit name="unlit_surface1" type="surfaceshader">
    <input name="emission" type="float" nodename="lookup" />
    <input name="opacity" type="float" value="1.0" />
  </surface_unlit>
  <surfacematerial name="test_array_inputs" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="unlit_surface1" />
  </surfacematerial>
</materialx>
